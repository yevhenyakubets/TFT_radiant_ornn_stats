# --- Riot Games API ---
# Get your key at https://developer.riotgames.com/
RIOT_API_KEY=RGAPI-YOUR-KEY-HERE

# --- Database Credentials ---
DB_USER=your_user_name
DB_PASSWORD=your_password
DB_NAME=your_db_name

# --- Database URL Construction ---
# Format: postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}
DATABASE_URL=postgresql://your_user_name:your_password@localhost:5432/your_db_name

# --- Frontend & CORS Settings ---
VITE_API_BASE_URL=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173