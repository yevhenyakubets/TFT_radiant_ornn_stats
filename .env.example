# Copy this file to a new file named '.env' in your local directory and 
# fill in your actual credentials.

# Your development or production API key from the Riot Developer Portal 
# (https://developer.riotgames.com/). Note: Development keys expire every 24 hours.
RIOT_API_KEY=RGAPI-YOUR-ACTUAL-API-KEY-HERE

# The username used to authenticate with the PostgreSQL database container.
DB_USER=postgres

# A strong, unique password for your database user.
DB_PASSWORD=your_secure_database_password_here

# The name of the database where champion, item, and match statistics are stored.
DB_NAME=db_name

# Full connection string used by your backend ORM (e.g., SQLAlchemy) to connect to the DB.
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}

# The base URL where your frontend (Vite) will look to make backend API requests.
# Use 'http://localhost:8000' or 'http://127.0.0.1:8000' for local development.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Comma-separated list of frontend URLs allowed to bypass CORS security to access the backend.
# Crucial for letting your local Vite dev server (usually port 5173) talk to the FastAPI/Python server.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# The connection string for your Redis instance.
# If running inside Docker, 'redis' maps directly to the container service name.
REDIS_URL=redis://redis:6379/0